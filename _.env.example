# Скопируй в .env и впиши свои значения. .env никогда не загружай в GitHub.

# Токен Lolz API (lolz.team/account/api — права: basic, read, payment, market)
LOLZ_TOKEN=

# Токен Telegram-бота управления (от @BotFather)
BOT_TOKEN=

# Твой Telegram ID (узнать у @userinfobot) — только этот ID управляет ботом
ADMIN_ID=

# api_id и api_hash для Telethon (my.telegram.org -> API development tools)
API_ID=
API_HASH=

# Строка подключения к Postgres (Neon.tech)
DATABASE_URL=
