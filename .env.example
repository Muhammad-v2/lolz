# Скопируй этот файл в .env и впиши свои значения.
# .env никогда не загружай в GitHub — он уже в .gitignore

# Токен Lolz API (настройки профиля -> API)
LOLZ_TOKEN=

# Токен Telegram-бота управления (от @BotFather)
BOT_TOKEN=

# Твой Telegram ID (узнать у @userinfobot) — только этот ID сможет управлять ботом
ADMIN_ID=

# api_id и api_hash для Telethon (с my.telegram.org -> API development tools)
API_ID=
API_HASH=

# Строка подключения к Postgres (Neon.tech)
DATABASE_URL=

# Секретное слово Lolz при покупке
SECRET_WORD=Зенит